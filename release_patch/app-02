mendations"><div class="recommendation"><strong>${session?'برای مشاهده، بازخوانی را بزنید.':'ابتدا وارد حساب شوید.'}</strong></div></div></section><section class="card"><div class="card-head"><div><h2>گزارش فنی</h2><p>آخرین وضعیت Local/Cloud</p></div></div><pre class="sync-log">${escapeHTML(JSON.stringify({configured,authenticated:!!session,status:s.sync.status,pending:s.sync.pending,lastSyncAt:s.sync.lastSyncAt,lastMergeAt:s.sync.lastMergeAt},null,2))}</pre></section></div>`;
