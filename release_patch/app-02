  function updateSetting(key,value){store.update(s=>{if(['weeklyGoalMinutes','focusPreset'].includes(key))value=Number(value);if(['speechRate','fontScale'].includes(key))value=Number(value);s.settings[key]=value;return s;},'setting');FLH_A11Y?.apply(store.get().settings);toast('تنظیم ذخیره شد','good');}
