  function renderMe(){const s=store.get(),privacy=FLH_PRIVACY.get();return`<div class="stack"><section class="card"><div class="card-head"><div><h2>تنظیمات یادگیری و برنامه</h2><p>ظاهر، تمرکز، صوت، حریم خصوصی و داده</p></div></div><div class="settings-grid"><div class="setting-box"><h3>جلسه و تمرکز</h3><label class="field">هدف هفتگی (دقیقه)<input type="number" min="30" max="3000" value="${s.settings.weeklyGoalMinutes}" data-setting="weeklyGoalMinutes"></label><label class="field">پومودورو پیش‌فرض<select data-setting="focusPreset">${[15,25,50,90].map(x=>`<option ${x==s.settings.focusPreset?'selected':''} value="${x}">${x} دقیقه</option>`).join('')}</select></label><label class="field">سرعت تلفظ<select data-setting="speechRate">${[[.65,'آهسته'],[.8,'آموزشی'],[.95,'طبیعی'],[1.1,'سریع']].map(([v,l])=>`<option ${v==s.settings.speechRate?'selected':''} value="${v}">${l}</option>`).join('')}</select></label><label class="field"><span><input type="checkbox" ${s.settings.sound?'checked':''} data-setting="sound"> پخش صدا فعال</span></label></div><div class="setting-box"><h3>ظاهر و دسترس‌پذیری</h3><label class="field">حالت نمایش<select data-setting="appearance"><option value="system" ${s.settings.appearance==='system'?'selected':''}>مطابق دستگاه</option><option value="light" ${s.settings.appearance==='light'?'selected':''}>روشن</option><option value="dark" ${s.settings.appearance==='dark'?'selected':''}>تیره</option></select></label><label class="field">اندازه متن<select data-setting="fontScale">${[[.9,'کوچک'],[1,'استاندارد'],[1.1,'بزرگ'],[1.2,'خیلی بزرگ']].map(([v,l])=>`<option ${v==s.settings.fontScale?'selected':''} value="${v}">${l}</option>`).join('')}</select></label><label class="field"><span><input type="checkbox" ${s.settings.highContrast?'checked':''} data-setting="highContrast"> کنتراست بالا</span></label></div><div class="setting-box"><h3>حریم خصوصی</h3><p class="muted">رضایت ثبت‌شده: ${privacy.accepted?'بله':'خیر'}<br>ضبط محلی: ${privacy.localRecordingConsent?'مجا