  }
  function renderGateFields(){const p=FLH_PROFILES[gateDraft.profile];$('#gateLanguages').innerHTML=['en','de'].map(l=>`<button type="button" class="language-choice ${gateDraft.language===l?'active':''}" data-gate-language="${l}">${FLH_LANGUAGE_META[l].flag}<strong>${FLH_LANGUAGE_META[l].fa}</strong><small>${l==='en'?'English':'Deutsch'}</small></button>`).join('');$$('[data-gate-language]').forEach(b=>b.onclick=()=>{gateDraft.language=b.dataset.gateLanguage;gateDraft.level=p.id==='aria'?'PRE':p.levels[gateDraft.language];gateDraft.goal=p.goals[gateDraft.language][0];renderGateFields();});const levels=p.id==='aria'?['PRE']:p.id==='elena'?['A0','A1','A2','B1']:['A0','A1','A2','B1','B2','C1','C2'];$('#gateLevel').innerHTML=levels.map(l=>`<option value="${l}" ${l===gateDraft.level?'selected':''}>${levelLabel(l)}</option>`).join('');$('#gateLevel').disabled=p.id==='aria';$('#gateGoal').innerHTML=p.goals[gateDraft.language].map(g=>`<option ${g===gateDraft.goal?'selected':''}>${g}</option>`).join('');$('#gateDuration').value=gateDraft.duration;$('#gateDurationValue').textContent=gateDraft.duration;$('#gateLevel').onchange=e=>gateDraft.level=e.target.value;$('#gateGoal').onchange=e=>gateDraft.goal=e.target.value;$('#gateDuration').oninput=e=>{$('#gateDurationValue').textContent=e.target.value;gateDraft.duration=+e.target.value;};}
  function applyGate(){store.update(s=>{s.active={...s.active,...gateDraft};return s;},'session-gate');store.clearPlan();plan=engine.buildDailyPlan({force:true});store.savePlan(plan);$('#sessionGate').close();switchView('today');toast('مسیر نشست تنظیم شد','good');}

  function openFirstIncomplete(){const ctx=engine.active(),item=plan.steps.find(x=>!ctx.progress.lessons[x.id]?.done)||plan.steps[0];if(item)openTask(item.id);}
  function openUnit(id){const unit=FLH_CURRICULUM.units.find(x=>x.id===id),ctx=engine.active();if(!unit)return;const access=engine.unitAccess(unit,ctx);if(access.state==='locked')return toast(access.reason,'bad');store.update(s=>{s.active.level=unit.level;return s;},'open-unit');store.clearPlan();plan=engine.buildDailyPlan({force:true,unit});store.savePlan(plan);switchView('today');}

  function openTask(id){plan=plan||engine.buildDailyPlan();const task=plan.steps.find(x=>x.id===id);if(!task)return;const d=$('#taskDialog');$('#taskDialogBody').innerHTML=taskDialog(task);bindTask(task,d);d.showModal();}
  function taskDialog(t){return`<div class="dialog-head"><div><span class="badge">${engine.skillFa(t.skill)} · ${t.minutes} دقیقه</span><h2>${t.title}</h2><p>${t.description}</p></div><button class="close-btn" aria-label="بستن">×</button></div><div class="task-body">${taskBody(t)}</div>`;}
  function taskBody(t){
    if(t.type==='lesson')return`<div class="callout"><strong>${t.prompt}</strong><p>${t.explanation}</p><div class="model-text">${t.model||''}</div></div><button class="primary-btn task-complete" data-score="85">فهمیدم و ادامه می‌دهم</button>`;
    if(t.type==='flash')return`<div class="flash-card"><small>برای دیدن معنی لمس کنید</small><strong>${t.prompt}</strong><span>${t.translation}</span></div><div class="button-row"><button class="secondary-btn task-complete" data-score="60">نیاز به مرور</button><button class="primary-btn task-complete" data-score="90">به خاطر سپردم</button></div>`;
    if(t.type==='listen-mcq')return`<div class="listen-panel"><button class="audio-button" data-play="${encodeURIComponent(t.audio)}">🔊 پخش</button><p>${t.prompt}</p></div><div class="choice-grid">${t.choices.map(c=>`<button class="choice-btn" data-choice="${escapeHTML(c)}">${escapeHTML(c)}</button>`).join('')}</div><div class="task-feedback"></div>`;
    if(t.type==='visual-choice'||t.type==='sound-picture')return`<div class="listen-panel"><button class="audio-button" data-play="${encodeURIComponent(t.audio)}">🔊 گوش کن</button><p>${t.prompt||'تصویر درست را انتخاب کن.'}</p></div><div class="visual-choice-grid">${t.items.map(x=>`<button class="visual-choice" data-choice="${x.id}" style="--item-color:${x.color}"><span>${x.emoji}</span><strong>${x.word}</strong></button>`).join('')}</div><div class="task-feedback"></div>`;
    if(t.type==='trace-letter')return`<div class="trace-layout"><div class="trace-card"><strong>${t.letter}</strong><span>${t.word} · ${t.translation}</span><span class="big-emoji">${t.emoji}</span><button class="secondary-btn" data-play="${encodeURIComponent(t.word)}">🔊 ${t.word}</button></div><div><canvas id="traceCanvas" class="trace-canvas" width="700" height="360"></canvas><div class="button-row"><button id="clearTrace" class="secondary-btn">پاک‌کردن</button><button class="primary-btn task-complete" data-score="88">ردگیری را انجام دادم</button></div></div></div>`;
    if(t.type==='writing')return`<div class="writing-task"><div class="callout"><strong>${t.prompt}</strong><ul>${t.criteria.map(x=>`<li>${x}</li>`).join('')}</ul></div><textarea id="taskText" rows="8" placeholder="اینجا بنویسید…"></textarea><div class="writing-footer"><span><b id="wordCount">۰</b> کلمه</span><button class="primary-btn" id="submitWriting">ثبت و خودارزیابی</button></div><div class="task-feedback"></div></div>`;
    if(t.type==='record-speech')return`<div class="record-task"><div class="callout"><strong>${t.prompt}</strong><div class="model-text">${t.model}</div></div><div class="record-panel"><div class="record-state"><i id="recordDot" class="record-dot"></i><strong id="recordLabel">آماده ضبط محلی</strong></div><div class="button-row"><button id="recordStart" class="primary-btn">شروع ضبط</button><button id="recordStop" class="secondary-btn" disabled>پایان ضبط</button><button id="recordConsent" class="secondary-btn">تنظیم رضایت</button></div><div id="recordPreview"></div><small>فایل فقط روی همین دستگاه ذخیره می‌شود و در Cloud Sync یا JSON Backup قرار نمی‌گیرد.</small></div><button class="primary-btn task-complete" data-score="82">خودارزیابی و ثبت عملکرد</button></div>`;
    if(t.type==='build')return`<div class="token-bank">${t.tokens.map(x=>`<button class="token" data-token="${x}">${x}</button>`).join('')}</div><div id="builtSentence" class="built-sentence"></div><button id="checkBuild" class="primary-btn">بررسی جمله</button><div class="task-feedback"></div>`;
    if(t.type==='reading')return`<div class="reading-card"><p>${t.explanation}</p><strong>${t.question}</strong></div><textarea id="readingAnswer" rows="5" placeholder="پاسخ یا جمع‌بندی شما…"></textarea><button class="primary-btn task-complete" data-score="82">پاسخ را ثبت کردم</button>`;
    if(t.type==='story-sequence')return`<div class="story-sort">${t.steps.map(x=>`<button class="story-step" data-order="${x.order}"><span>${x.emoji}</span>${x.text}</button>`).join('')}</div><div id="storySequence" class="built-sentence"></div><button id="checkStory" class="primary-btn">بررسی ترتیب</button><div class="task-feedback"></div>`;
    if(t.type==='parent')return`<div class="parent-task"><div class="visual-large">${t.emoji||'🧸'}</div><h3>${t.prompt}</h3><p>${t.model}</p><button class="secondary-btn" data-play="${encodeURIComponent(t.model||t.prompt)}">🔊 پخش آرام</button><div class="parent-actions">${['گوش داد','اشاره کرد','حرکت کرد','تکرار کرد','فقط مشاهده کرد'].map(x=>`<label><input type="checkbox" value="${x}">${x}</label>`).join('')}</div><button id="saveParent" class="primary-btn">ثبت مشاهده و پایان مثبت</button></div>`;
    if(t.type==='review')return`<div class="review-list">${t.cards.length?t.cards.map(x=>`<article><strong>${x.target||x.prompt||x.title}</strong><small>${x.fa||x.correctAnswer||x.answer||''}</small></article>`).join(''):'<p>مرور سررسید ندارید؛ یک مرور کوتاه از درس فعلی انجام دهید.</p>'}</div><button class="primary-btn task-complete" data-score="90">مرور انجام شد</button>`;
    if(t.type==='mission')return`<div class="mission-card"><h3>${t.prompt}</h3>${t.checklist.map(x=>`<label><input type="checkbox">${x}</label>`).join('')}</div><button class="primary-btn task-complete" data-score="92">مأموریت انجام شد</button>`;
    if(t.type==='reflection')return`<div class="reflection-grid">${t.prompts.map((x,i)=>`<label>${x}<textarea data-reflection="${i}" rows="2"></textarea></label>`).join('')}</div><button class="primary-btn task-complete" data-score="86">ثبت بازتاب</button>`;
    if(t.type==='parent-check')return`<div class="parent-check"><h3>${t.prompt}</h3>${t.choices.map(x=>`<label><input type="checkbox" value="${x}">${x}</label>`).join('')}<textarea id="parentNote" rows="3" placeholder="یادداشت اختیاری والد"></textarea></div><button id="saveParentCheck" class="primary-btn">ثبت مشاهده</button>`;
    return`<button class="primary-btn task-complete" data-score="80">تکمیل</button>`;
  }
