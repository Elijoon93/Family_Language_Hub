  function testStorage(){try{localStorage.setItem('__flh_test','1');const ok=localStorage.getItem('__flh_test')==='1';localStorage.removeItem('__flh_test');return ok;}catch(e){return false;}}

  function openAuth(mode='signin'){
    if(!FLH_AUTH.configured()){toast('ابتدا Supabase URL و کلید عمومی را در config.js ثبت کنید.','bad');return;}
    const title=mode==='signup'?'ساخت حساب خانوادگی':'ورود حساب خانوادگی';
    $('#authDialogBody').innerHTML=`<div class="dialog-shell"><header class="dialog-head"><div><span class="badge">Supabase Auth</span><h2>${title}</h2><small>یک حساب مشترک فقط برای دو دستگاه خانواده</small></div><button class="close-btn" id="closeAuth">×</button></header><div class="dialog-body"><div class="auth-grid"><label class="field">ایمیل<input id="authEmail" type="email" autocomplete="email" dir="ltr"></label><label class="field">رمز عبور<input id="authPassword" type="password" minlength="8" autocomplete="${mode==='signup'?'new-password':'current-password'}" dir="ltr"></label></div><div class="privacy-notice" style="margin-top:12px">Service Role Key هرگز در برنامه استفاده نمی‌شود. فقط Publishable/Anon Key عمومی لازم است.</div></div><footer class="dialog-actions"><button id="submitAuth" class="primary-btn">${title}</button></footer></div>`;
    $('#closeAuth').onclick=()=>$('#authDialog').close();$('#submitAuth').onclick=async()=>{const email=$('#authEmail').value.trim(),password=$('#authPassword').value;if(!email||password.length<8){toast('ایمیل و رمز حداقل ۸ کاراکتری لازم است.','bad');return;}try{$('#submitAuth').disabled=true;if(mode==='signup')await FLH_AUTH.signUp(email,password);else await FLH_AUTH.signIn(email,password);await FLH_SYNC.registerDevice();$('#authDialog').close();toast('حساب خانوادگی متصل شد.','good');renderView();}catch(e){toast(e.message||String(e),'bad');$('#submitAuth').disabled=false;}};$('#authDialog').showModal();
  }
  async function runSync(){const b=$('#syncNowBtn');try{if(b)b.disabled=true;const result=await FLH_SYNC.syncNow();toast(`همگام‌سازی کامل شد: ${result.pushed} ارسال، ${result.events} دریافت`,'good');renderView();}catch(e){toast(e.message||String(e),'bad');renderView();}finally{if(b)b.disabled=false;}}
  async function loadDevices(){const root=$('#deviceList');if(!root||!FLH_AUTH.getSession())return;root.innerHTML='<div class="recommendation"><strong>در حال دریافت…</strong></div>';try{const rows=await FLH_SYNC.devices();root.innerHTML=rows.length?rows.map(d=>`<div class="recommendation"><strong>${d.device_id===store.getDeviceId()?'📱 دستگاه فعلی':'💻 دستگاه دیگر'}</strong><small>${escapeHTML(d.device_name||d.device_id)} · ${formatDate(d.last_seen_at)}</small>${d.device_id!==store.getDeviceId()?`<button class="danger-btn" data-remove-device="${escapeAttr(d.device_id)}">حذف دستگاه</button>`:''}</div>`).join(''):'<div class="recommendation"><strong>دستگاهی ثبت نشده است.</strong></div>';$$('[data-remove-device]',root).forEach(b=>b.onclick=async()=>{try{await FLH_SYNC.removeDevice(b.dataset.removeDevice);loadDevices();}catch(e){toast(e.message,'bad');}});}catch(e){root.innerHTML=`<div class="feedback bad">${escapeHTML(e.message||String(e))}</div>`;}}
  function openPrivacy(){const p=FLH_PRIVACY.get();$('#privacyDialogBody').innerHTML=`<div class="dialog-shell"><header class="dialog-head"><div><h2>حریم خصوصی خانواده</h2><small>رضایت قابل لغو و داده کودک Private by Default</small></div><button class="close-btn" id="closePrivacy">×</button></header><div class="dialog-body"><div class="privacy-notice">${FLH_PRIVACY.noticeFa()}</div><div class="stack" style="margin-top:14px"><label class="answer-option"><input id="acceptPrivacy" type="checkbox" ${p.accepted?'checked':''}> متن حریم خصوصی را خوانده‌ام.</label><label class="answer-option"><input id="acceptLocalRecord" type="checkbox" ${p.localRecordingConsent?'checked':''}> ضبط صوت فقط روی این دستگاه برای سعید، آرزو و النا مجاز است.</label><label class="answer-option"><input type="checkbox" disabled> آپلود خودکار صدا به Cloud — غیرفعال دائمی</label></div></div><footer class="dialog-actions"><button id="savePrivacy" class="primary-btn">ثبت تنظیمات</button><button id="revokePrivacy" class="danger-btn">لغو رضایت</button></footer></div>`;$('#closePrivacy').onclick=()=>$('#privacyDialog').close();$('#savePrivacy').onclick=()=>{if(!$('#acceptPrivacy').checked){toast('برای فعال‌سازی ضبط محلی، تأیید متن لازم است.','bad');return;}const next=FLH_PRIVACY.accept({localRecordingConsent:$('#acceptLocalRecord').checked,cloudAudioConsent:false});store.update(s=>{s.settings.privacyAccepted=next.accepted;s.settings.localRecordingConsent=next.localRecordingConsent;return s;},'privacy');$('#privacyDialog').close();toast('تنظیمات حریم خصوصی ثبت شد.','good');renderView();};$('#revokePrivacy').onclick=()=>{FLH_PRIVACY.revoke();store.update(s=>{s.settings.privacyAccepted=false;s.settings.localRecordingConsent=false;return s;},'privacy-revoke');$('#privacyDialog').close();toast('رضایت لغو شد.','good');renderView();};$('#privacyDialog').showModal();}
  async function loadRecordings(){const root=$('#recordingsList');if(!root)return;if(!FLH_RECORDER.supported()){root.innerHTML='<div class="recommendation"><strong>ضبط صدا در این مرورگر پشتیبانی نمی‌شود.</strong></div>';return;}try{const rows=await FLH_RECORDER.list();root.innerHTML=rows.length?rows.slice().reverse().map(r=>`<div class="recording-row"><div><strong>${escapeHTML(r.profile||'—')} · ${escapeHTML(r.language||'—')}</strong><small>${r.durationSeconds||0} ثانیه · ${formatDate(r.createdAt)} · Local only</small></div><button class="danger-btn" data-delete-recording="${escapeAttr(r.id)}">حذف</button></div>`).join(''):'<div class="recommendation"><strong>ضبط محلی وجود ندارد.</strong></div>';$$('[data-delete-recording]',root).forEach(b=>b.onclick=async()=>{await FLH_RECORDER.remove(b.dataset.deleteRecording);loadRecordings();});}catch(e){root.innerHTML=`<div class="feedback bad">${escapeHTML(e.message||String(e))}</div>`;}}
