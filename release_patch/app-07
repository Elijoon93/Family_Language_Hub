  function updateSetting(k,v){const numeric=['weeklyGoalMinutes','focusPreset','speechRate','fontScale'];store.update(s=>{s.settings[k]=numeric.includes(k)?+v:v;return s;},'setting');FLH_A11Y.apply(store.get().settings);toast('تنظیم ذخیره شد','good');}
  function updateSyncBadge(){const s=store.get(),el=$('#syncState');if(!el)return;const cloud=FLH_AUTH?.configured(),logged=!!FLH_AUTH?.getSession();const colour=!navigator.onLine?'#ef4444':s.sync.status==='error'?'#ef4444':s.sync.status==='syncing'?'#f59e0b':'#22c55e';el.querySelector('i').style.background=colour;el.querySelector('span').textContent=!navigator.onLine?`آفلاین · ${s.sync.pending||0} در صف`:cloud&&logged?(s.sync.status==='syncing'?'در حال همگام‌سازی':`متصل · ${s.sync.pending||0} در صف`):cloud?'ابر تنظیم شده؛ ورود لازم':'ذخیره محلی فعال';}

